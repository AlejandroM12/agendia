# Copiar como .env.local y completar con valores de desarrollo.
# Nunca commitear .env.local ni ningún archivo con secretos reales.
# Para producción ver deploy/.env.production.example.

# "saas" o "standalone" (instalación independiente: sin facturación ni /admin).
DEPLOYMENT_MODE=saas

# PostgreSQL. En desarrollo alcanza un contenedor local:
#   docker run -d --name agendia-postgres -p 54330:5432 -e POSTGRES_USER=agendia \
#     -e POSTGRES_PASSWORD=agendia_dev_local -e POSTGRES_DB=agendia postgres:17-alpine
DATABASE_URL=postgresql://agendia:agendia_dev_local@localhost:54330/agendia

# Secreto de sesiones (Auth.js). Generar con: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-base64-secret

# URL pública de la app (enlaces de reservas y de los emails).
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Secreto que comparten la app y el worker (npm run worker).
CRON_SECRET=replace-with-another-random-secret

# Email de contacto que muestra el sitio.
# (El acceso a /admin no se configura acá: npm run admin:grant <email>)
CONTACT_EMAIL=

# Email (Resend). Sin estos valores no se envía nada: los avisos quedan como
# "No enviado" y, solo en desarrollo, el enlace de recuperación se muestra en pantalla.
RESEND_API_KEY=
EMAIL_FROM=

# Mercado Pago (suscripción mensual y compra de la licencia). Sin estos
# valores no se ofrece el pago online.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
