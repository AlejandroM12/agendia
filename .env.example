# Copiar como .env.local y completar con valores de desarrollo.
# Nunca commitear .env.local ni ningún archivo con secretos reales.
# Para producción ver deploy/.env.production.example.

# "saas" o "standalone" (instalación independiente: sin facturación ni /admin).
DEPLOYMENT_MODE=saas

# PostgreSQL. En desarrollo alcanza un contenedor local:
#   docker run -d --name agendia-postgres -p 54330:5432 -e POSTGRES_USER=agendia \
#     -e POSTGRES_PASSWORD=agendia_dev_local -e POSTGRES_DB=agendia postgres:17-alpine
DATABASE_URL=postgresql://agendia:agendia_dev_local@localhost:54330/agendia

# Secreto de sesiones (Auth.js). Generar con: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-base64-secret

# URL pública de la app (enlaces de reservas y de los emails).
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Secreto que comparten la app y el worker (npm run worker).
CRON_SECRET=replace-with-another-random-secret

# Email de contacto que muestra el sitio.
# (El acceso a /admin no se configura acá: npm run admin:grant <email>)
CONTACT_EMAIL=

# WhatsApp automático (Meta Cloud API). Se configura UNA sola vez para toda la plataforma: las credenciales de cada
# negocio se cargan desde /admin (cifradas con esta clave), no acá. Generarla con: openssl rand -base64 32
# Guardarla aparte: si se pierde, hay que volver a cargar las credenciales de cada negocio.
WHATSAPP_ENCRYPTION_KEY=
# Solo al rotar la clave: la anterior, para seguir leyendo lo ya cifrado.
WHATSAPP_ENCRYPTION_KEY_PREVIOUS=
# Versión de la Graph API (opcional).
WHATSAPP_GRAPH_VERSION=

# Email (Resend). Sin estos valores no se envía nada: los avisos quedan como
# "No enviado" y, solo en desarrollo, el enlace de recuperación se muestra en pantalla.
RESEND_API_KEY=
EMAIL_FROM=

# Modo equipo (varios profesionales por negocio): apagado por defecto. "1" lo
# enciende para toda la instalación; para un solo negocio usar
# `npm run team:mode -- <enlace> on`. Ver docs/MULTI_PROFESSIONAL.md.
TEAM_MODE_ENABLED=
# Cuentas individuales e invitaciones (etapa 4): apagado por defecto. "1" lo habilita
# para toda la instalación; por negocio: `npm run team:mode -- <enlace> accounts-on`.
TEAM_ACCOUNTS_ENABLED=
# Publicación comercial de los planes Profesional y Equipo (etapa 5): apagada por defecto.
# "1" muestra ambos planes en la landing, habilita el modo equipo y las cuentas individuales
# para todos los negocios según su plan y permite contratar el Plan Equipo. Se lee en ejecución
# (la landing y /precios no son estáticas): alcanza con reiniciar `web` y `worker`.
PUBLISH_TEAM_PLANS=
# Interruptor de emergencia: "1" detiene la activación automática de las funciones de equipo
# (no se habilitan negocios nuevos ni se vende el Plan Equipo). No borra nada.
TEAM_FEATURES_PAUSED=
# Días de adaptación cuando un negocio baja de plan y tiene más profesionales que lugares.
CAPACITY_GRACE_DAYS=7
# Precios de lista en ARS (los fija el build de las páginas públicas). El precio que se cobra sale
# de la tabla plans y debe coincidir con estos: si no, no se vende (docs/COMMERCIAL.md).
PRICE_MONTHLY=9900
PRICE_TEAM_MONTHLY=19900
PRICE_ONE_TIME=149000
PRICE_LICENSE_TEAM=249000
# Solo instalación independiente: nivel de la licencia ("profesional" = 2 profesionales, "equipo" = 5).
LICENSE_TIER=

# Mercado Pago (suscripción mensual y compra de la licencia). Sin estos
# valores no se ofrece el pago online.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Modo de las credenciales de Mercado Pago, OBLIGATORIO para ofrecer el pago online:
#   live  -> credenciales de PRODUCCIÓN: cualquiera puede pagar.
#   test  -> credenciales de PRUEBA: solo pueden pagar los emails de MERCADOPAGO_TEST_EMAILS
#            (separados por comas), para que un token de prueba nunca habilite «pagos» públicos.
# Vacío = pago online apagado.
MERCADOPAGO_MODE=
MERCADOPAGO_TEST_EMAILS=

# Demostración pública (/demo): cada visitante recibe un negocio ficticio propio que no envía nada real.
# "1" la apaga (interruptor de emergencia); vacío = encendida.
DEMO_DISABLED=
