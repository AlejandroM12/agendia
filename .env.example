# Copiar como .env.local y completar con valores reales de desarrollo.
# Nunca commitear .env.local ni ningún archivo con secretos reales.

# Modo de despliegue: "saas" o "standalone" (ver docs/ARCHITECTURE.md).
DEPLOYMENT_MODE=saas

# Cadena de conexión a PostgreSQL.
DATABASE_URL=postgresql://user:password@localhost:5432/agendia

# Clave secreta usada por Auth.js para firmar sesiones (JWT).
# Generar una propia con: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-base64-secret

# URL base de la aplicación (usada por Auth.js para construir callbacks).
AUTH_URL=http://localhost:3000

# --- Variables para fases posteriores (todavía no utilizadas) ---
# RESEND_API_KEY=
# MERCADOPAGO_ACCESS_TOKEN=
