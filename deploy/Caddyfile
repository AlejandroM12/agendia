# Proxy inverso con HTTPS automático. Caddy obtiene y renueva solo el
# certificado de Let's Encrypt para {$DOMAIN}; el DNS del dominio debe
# apuntar a este servidor y los puertos 80 y 443 estar abiertos.

{$DOMAIN} {
	encode zstd gzip

	# El punto de entrada del worker es interno: nunca se expone a Internet.
	@internal path /api/internal/*
	respond @internal 404

	reverse_proxy web:3000 {
		health_uri /api/health
		health_interval 30s
	}

	log {
		output stdout
		format console
	}
}
