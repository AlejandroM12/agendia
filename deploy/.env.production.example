# Copiar a .env.production (en la raíz del proyecto, en el servidor) y completar.
# .env.production NUNCA se sube al repositorio. Permisos sugeridos: chmod 600.

# Dominio público, sin https:// (el DNS debe apuntar a este servidor).
DOMAIN=agendia.example.com

# "saas" (plataforma con prueba y suscripción) o "standalone" (instalación
# independiente con licencia de compra única: sin facturación ni /admin).
DEPLOYMENT_MODE=saas

# Base de datos. Generar la contraseña con: openssl rand -hex 24
POSTGRES_USER=agendia
POSTGRES_DB=agendia
POSTGRES_PASSWORD=

# Secretos de la aplicación. Generar cada uno con: openssl rand -base64 32
AUTH_SECRET=
CRON_SECRET=

# Email de contacto que muestra el sitio.
CONTACT_EMAIL=

# Envío de emails (Resend). Sin estos dos valores no se envía ningún email:
# los avisos quedan registrados como "No enviado".
RESEND_API_KEY=
EMAIL_FROM="Agendia <turnos@agendia.example.com>"

# Modo equipo (varios profesionales por negocio): dejar vacío. "1" lo enciende
# para toda la instalación; para un negocio concreto: scripts/team-mode.mjs.
TEAM_MODE_ENABLED=

# Mercado Pago (suscripción mensual y compra de la licencia). Sin estos
# valores el pago online no se ofrece.
# El secreto del webhook NO es el access token: son credenciales distintas.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Precios (ARS). PRICE_MONTHLY es el que muestra la landing: tiene que
# coincidir con el del plan, que se edita en /admin. PRICE_ONE_TIME es el
# que se cobra por la licencia independiente.
PRICE_MONTHLY=14000
PRICE_ONE_TIME=199000
# Valor anual de renovación de hosting, dominio y soporte de la licencia (a
# partir del mes 13). Vacío = el sitio dice que se informa antes de comprar.
PRICE_LICENSE_RENEWAL=

# Copias de seguridad: carpeta del servidor y cuántas conservar.
BACKUP_DIR=./backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# Copia externa de los backups (opcional pero recomendada). Requiere
# deploy/rclone.conf con el destino; ver docs/DEPLOYMENT.md.
#   COMPOSE_PROFILES=offsite
#   OFFSITE_REMOTE=agendia-backups:nombre-del-bucket
COMPOSE_PROFILES=
OFFSITE_REMOTE=
