# Copiar a `.env.mp-test` (está ignorado por git: `.env*`). NUNCA subir ni pegar en un chat el archivo real.
#
# Credenciales de PRUEBA de la aplicación de Mercado Pago (Tus integraciones → la aplicación → Credenciales → «Prueba»).
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta del webhook de PRUEBA (Tus integraciones → la aplicación → Webhooks → modo prueba).
MERCADOPAGO_WEBHOOK_SECRET=

# Usuario COMPRADOR de prueba (Credenciales → Cuentas de prueba). Solo si querés que los scripts lo usen.
MP_BUYER_EMAIL=
MP_BUYER_USER=
MP_BUYER_PASSWORD=
