// Esquema de base de datos — Agendia

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 ya no acepta `url` en el datasource del schema: la conexión para
// Migrate/Studio se configura en prisma.config.ts, y el runtime recibe un
// driver adapter explícito en el constructor de PrismaClient (ver lib/db.ts).
datasource db {
  provider = "postgresql"
}

enum DeploymentMode {
  saas
  standalone
}

enum OrganizationStatus {
  trial // prueba gratuita activa (trialPolicy.trialDays, hoy 14)
  trial_readonly // prueba vencida, acceso de solo lectura (30 días)
  locked // período de solo lectura agotado, sin acceso operativo
  active // suscripción vigente
  past_due // pago vencido, en regularización
  canceled
  suspended // suspendida manualmente por administración SaaS
}

enum MembershipRole {
  owner
  admin
  professional // acceso individual de un profesional a SU agenda (invitación)
}

enum InvitationStatus {
  pending
  accepted
  revoked
}

model Organization {
  id             String             @id @default(uuid())
  name           String
  slug           String             @unique
  timezone       String             @default("America/Argentina/Buenos_Aires")
  deploymentMode DeploymentMode     @default(saas)
  status         OrganizationStatus @default(trial)
  trialStartedAt DateTime           @default(now())
  trialEndsAt    DateTime
  readonlyUntil  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Perfil público del negocio
  industry    String?
  description String?
  phone       String?
  address     String?

  onboardingCompletedAt DateTime?

  // Página pública personalizable (ver lib/theme.ts y modules/public-page).
  // Los colores son hexadecimales validados; la tipografía, una de las
  // opciones predefinidas. Nunca se guarda CSS ni HTML del usuario.
  specialty      String?
  whatsapp       String?
  instagram      String?
  themePrimary   String  @default("#1f4d3f")
  themeSecondary String  @default("#c8643c")
  themeFont      String  @default("clasica")
  showAddress    Boolean @default(true)
  showPhone      Boolean @default(true)
  showWhatsapp   Boolean @default(true)
  showInstagram  Boolean @default(true)
  showPrices     Boolean @default(true)

  // Equipos con varios profesionales (docs/MULTI_PROFESSIONAL.md). Apagado
  // por defecto: mientras sea `false` (y no esté TEAM_MODE_ENABLED=1), el
  // negocio funciona exactamente como siempre, con un único profesional.
  // `extraProfessionals` son cupos adicionales a los del plan (por ejemplo,
  // una ampliación pactada); no cambia ningún precio.
  teamModeEnabled         Boolean @default(false)
  extraProfessionals      Int     @default(0)
  // Cuentas individuales e invitaciones (etapa 4): se habilitan aparte del
  // modo equipo, por negocio o con TEAM_ACCOUNTS_ENABLED=1 (lib/features.ts).
  teamAccountsEnabled     Boolean @default(false)
  // Qué pueden hacer los profesionales con cuenta propia en este negocio
  // (ver lib/permissions.ts). Nulo = valores predeterminados.
  professionalPermissions Json?

  // Comercial (etapa 5). `intendedPlan` es solo la intención con la que llegó
  // (CTA del plan): no da cupos ni cobra nada. `workMode` es la respuesta del
  // onboarding («¿Cómo trabajás?»): "solo" | "team".
  intendedPlan           String?
  workMode               String?
  // Exceso de cupo tras bajar de plan: desde `capacityGraceStartedAt` rige un
  // período de adaptación hasta `capacityGraceEndsAt`; después, los
  // profesionales excedentes dejan de recibir reservas NUEVAS (nunca se borra ni
  // se cancela nada). Ver modules/team/capacity.ts.
  capacityGraceStartedAt DateTime?
  capacityGraceEndsAt    DateTime?

  // Reglas de agenda (ver modules/availability)
  slotIntervalMinutes     Int @default(30)
  bufferMinutes           Int @default(0)
  minNoticeMinutes        Int @default(120)
  maxAdvanceDays          Int @default(60)
  cancellationNoticeHours Int @default(2)

  // Demostración (docs/DEMO.md). Un negocio de demostración es ficticio y aislado: nunca envía avisos reales
  // (salvo una demo SUPERVISADA, y solo a `demoAllowedRecipients`), no tiene facturación y se borra al vencer.
  isDemo                Boolean   @default(false)
  demoKind              String? // "public" | "supervised"
  demoExpiresAt         DateTime?
  demoAllowedRecipients String[]  @default([])

  // Recordatorios
  remindersEnabled     Boolean @default(true)
  reminderHoursBefore  Int     @default(24)
  notifyOwnerOnBooking Boolean @default(true)

  memberships            Membership[]
  invitations            Invitation[]
  professionals          Professional[]
  services               Service[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  customers              Customer[]
  appointments           Appointment[]
  notifications          Notification[]
  subscription           Subscription?
  slugAliases            OrganizationSlugAlias[]
  images                 OrganizationImage[]
  customerAccessTokens   CustomerAccessToken[]
  whatsappConnection     WhatsappConnection?
  whatsappConsents       WhatsappConsent[]
  whatsappMessages       WhatsappMessage[]

  @@map("organizations")
}

// Persona que atiende clientes y tiene su propia agenda. No es lo mismo que
// un usuario con acceso al sistema (`userId` es opcional: un profesional puede
// existir sin cuenta) ni que el propietario (que solo ocupa un cupo si
// también atiende, es decir, si tiene un profesional activo).
model Professional {
  id             String   @id @default(uuid())
  organizationId String
  displayName    String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  description         String?
  /// Color identificador en la agenda (hexadecimal validado).
  color               String    @default("#1f4d3f")
  /// Orden de visualización y, a igualdad de carga, de asignación automática.
  sortOrder           Int       @default(0)
  bookableOnline      Boolean   @default(true)
  photoImageId        String?
  /// Cuenta de acceso asociada. Una persona puede ser profesional en varios
  /// negocios, pero solo una vez en cada uno (@@unique). La base garantiza
  /// (trigger) que sea miembro de ese negocio y la suelta si pierde la membresía.
  userId              String?
  /// Cuándo se revocó el acceso de la cuenta que tenía (para mostrar «Acceso revocado»).
  accessRevokedAt     DateTime?
  /// Excepciones a los permisos del negocio para este profesional (parcial).
  permissionOverrides Json?
  /// Selección del propietario ante un exceso de cupo: true = sigue recibiendo reservas, false = no. Nulo = sin elegir.
  keepBookable        Boolean?

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                   User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  photoImage             OrganizationImage?      @relation(fields: [photoImageId], references: [id], onDelete: SetNull)
  appointments           Appointment[]
  requestedAppointments  Appointment[]           @relation("RequestedProfessional")
  services               ServiceProfessional[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  invitations            Invitation[]

  // Permite claves foráneas compuestas (organizationId, id): la base de datos
  // garantiza que todo lo que apunta a un profesional es de su misma organización.
  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([organizationId, active, sortOrder])
  @@map("professionals")
}

model Service {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  description      String?
  durationMinutes  Int
  price            Int? // en la moneda local, sin decimales
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  /// `true`: lo realizan todos los profesionales activos. `false`: solo los
  /// que figuran en `professionals`.
  allProfessionals Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  professionals ServiceProfessional[]

  @@unique([organizationId, id])
  @@index([organizationId, active, sortOrder])
  @@map("services")
}

// Qué profesionales realizan un servicio cuando `Service.allProfessionals`
// es falso. Las claves compuestas con organizationId impiden, en la base de
// datos, vincular un servicio con un profesional de otra organización.
model ServiceProfessional {
  organizationId String
  serviceId      String
  professionalId String
  createdAt      DateTime @default(now())

  service      Service      @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Cascade)
  professional Professional @relation(fields: [organizationId, professionalId], references: [organizationId, id], onDelete: Cascade)

  @@id([serviceId, professionalId])
  @@index([professionalId])
  @@map("service_professionals")
}

// Horario semanal recurrente. Minutos desde la medianoche, en la zona
// horaria de la organización. Varias filas por día = horario cortado.
model AvailabilityRule {
  id             String  @id @default(uuid())
  organizationId String
  /// Profesional al que pertenece el horario. Una fila sin profesional solo
  /// existe de forma transitoria (ver el trigger de la migración team_foundation).
  professionalId String?
  weekday        Int // 0 = domingo … 6 = sábado
  startMinute    Int
  endMinute      Int

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [organizationId, professionalId], references: [organizationId, id], onDelete: Cascade)

  @@index([professionalId, weekday])
  @@index([organizationId, weekday])
  @@map("availability_rules")
}

// Bloqueo puntual. Sin startMinute/endMinute = día completo. Sin profesional
// = bloqueo general (feriados, cierres): afecta a todo el negocio.
model AvailabilityException {
  id             String   @id @default(uuid())
  organizationId String
  professionalId String?
  date           DateTime @db.Date
  startMinute    Int?
  endMinute      Int?
  reason         String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [organizationId, professionalId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, date])
  @@index([professionalId, date])
  @@map("availability_exceptions")
}

model Customer {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([organizationId, name])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@map("customers")
}

enum AppointmentStatus {
  confirmed
  completed
  canceled
  no_show
}

enum ProfessionalSelection {
  specific // un profesional concreto (elegido por el cliente o asignado por el negocio)
  any // el cliente eligió «cualquier profesional»
}

enum AppointmentSource {
  manual
  public_booking
}

// La migración agrega además una exclusion constraint
// (appointments_no_overlap) que impide dos turnos no cancelados
// superpuestos para el mismo profesional — ver la migración SQL.
model Appointment {
  id                      String                @id @default(uuid())
  organizationId          String
  professionalId          String
  serviceId               String
  customerId              String
  startsAt                DateTime
  endsAt                  DateTime
  status                  AppointmentStatus     @default(confirmed)
  source                  AppointmentSource     @default(manual)
  manageToken             String                @unique
  /// Profesional que pidió el cliente (null si eligió «cualquiera» o si el
  /// turno es anterior a los equipos). `professionalId` es el asignado.
  requestedProfessionalId String?
  professionalSelection   ProfessionalSelection @default(specific)
  /// Identifica un envío del formulario: un reintento o un doble clic con la
  /// misma clave devuelve el mismo turno en lugar de crear otro.
  idempotencyKey          String?
  notes                   String?
  price                   Int?
  canceledAt              DateTime?
  canceledBy              String? // "professional" | "customer"
  /// El cliente confirmó que va (por el enlace del turno o, más adelante, por WhatsApp).
  attendanceConfirmedAt   DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Un profesional con turnos no se puede borrar (se desactiva): el historial se conserva.
  professional          Professional   @relation(fields: [organizationId, professionalId], references: [organizationId, id], onDelete: NoAction)
  requestedProfessional Professional?  @relation("RequestedProfessional", fields: [organizationId, requestedProfessionalId], references: [organizationId, id], onDelete: NoAction)
  service               Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer              Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  notifications         Notification[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, startsAt])
  @@index([professionalId, startsAt])
  @@index([customerId])
  @@map("appointments")
}

enum NotificationType {
  booking_confirmation
  booking_received_owner
  reminder
  cancellation
  reschedule
  professional_change // el negocio le cambió el profesional al turno
  account_notice // aviso de la cuenta al propietario (prueba por vencer, cupo, plan); el tipo va en payload.kind
  cancellation_owner
  reschedule_owner
}

enum NotificationChannel {
  email
  whatsapp
  sms
}

enum NotificationStatus {
  pending
  sent
  failed
  canceled
  skipped // el canal no está configurado: no se intentó enviar
}

// Outbox de notificaciones: se persisten en la misma transacción que el
// cambio del turno y un proceso en segundo plano las envía.
model Notification {
  id             String              @id @default(uuid())
  organizationId String
  appointmentId  String?
  type           NotificationType
  channel        NotificationChannel @default(email)
  recipient      String
  scheduledFor   DateTime
  status         NotificationStatus  @default(pending)
  attempts       Int                 @default(0)
  lastError      String?
  sentAt         DateTime?
  idempotencyKey String              @unique
  lockedUntil    DateTime? // reclamada por un worker hasta este instante
  payload        Json? // datos extra del aviso (p. ej. { previousProfessionalId })
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model Plan {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  price     Int
  currency  String   @default("ARS")
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  subscriptions        Subscription[]
  pendingSubscriptions Subscription[] @relation("PendingPlan")

  @@map("plans")
}

enum SubscriptionStatus {
  pending
  active
  paused
  past_due
  canceled
}

// Una fila por inicio de sesión. El JWT lleva el id (`sid`): al revocar la fila esa sesión deja de
// valer en el próximo pedido, sin tocar las demás. Las sesiones anteriores a esta tabla (sin `sid`)
// siguen valiendo hasta que se cambia la contraseña o se cierran todas.
model UserSession {
  id         String    @id @default(uuid())
  userId     String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  device     String? // «Chrome en Windows»: solo para reconocerla, nunca la IP ni el user agent completo
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model Subscription {
  id                            String             @id @default(uuid())
  organizationId                String             @unique
  planId                        String
  status                        SubscriptionStatus @default(pending)
  provider                      String             @default("mercadopago")
  providerSubscriptionId        String?            @unique
  currentPeriodEnd              DateTime?
  lastPaymentAt                 DateTime?
  // Estado del último cobro consultado a Mercado Pago mientras no hay un primer cobro verificado («approved», «rejected»,
  // «in_process»…): permite mostrar «pago pendiente» o «rechazado». Nulo al contratar y en suscripciones anteriores.
  lastChargeStatus              String?
  // Cambio de plan en curso (modules/billing/plan-change.ts): el plan nuevo no
  // rige hasta que Mercado Pago confirma lo necesario (ver docs).
  pendingPlanId                 String?
  pendingProviderSubscriptionId String?            @unique
  pendingKind                   String? // "upgrade" | "downgrade"
  pendingEffectiveAt            DateTime?
  // Importe y moneda que se enviaron a Mercado Pago al crear la suscripción
  // vigente: lo que se verifica al sincronizar. Nulo en suscripciones anteriores.
  contractedAmount              Int?
  contractedCurrency            String?
  // Suscripción anterior de Mercado Pago que hay que cancelar tras un cambio de
  // plan verificado (se reintenta desde el worker hasta lograrlo).
  retiredProviderSubscriptionId String?
  canceledAt                    DateTime?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
  pendingPlan  Plan?        @relation("PendingPlan", fields: [pendingPlanId], references: [id])

  @@map("subscriptions")
}

// Registro idempotente de webhooks de pago: se persiste antes de procesar.
model PaymentEvent {
  id              String    @id @default(uuid())
  provider        String
  providerEventId String
  type            String
  resourceId      String?
  payload         Json
  processedAt     DateTime?
  error           String?
  receivedAt      DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@map("payment_events")
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@map("rate_limits")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  // Se incrementa al cambiar la contraseña: invalida las sesiones previas.
  sessionVersion  Int       @default(0)
  sessions        UserSession[]
  // Acceso al panel de plataforma (/admin). Solo se otorga desde el servidor
  // con `npm run admin:grant` — nunca por configuración ni desde la app.
  isPlatformAdmin Boolean   @default(false)
  // Momento en que la persona demostró que controla la casilla. Sin esto no
  // se puede usar la cuenta (ver lib/dal.ts).
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  professionals           Professional[]
  memberships             Membership[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

model Membership {
  id             String         @id @default(uuid())
  organizationId String
  userId         String
  role           MembershipRole @default(owner)
  createdAt      DateTime       @default(now())
  // Avisos internos de turnos: el propietario/administrador, los de todo el
  // negocio (si el negocio los tiene activos); el profesional, los de SUS turnos.
  notifyBookings Boolean        @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("memberships")
}

// El token en texto plano nunca se persiste: solo se guarda su hash.
// Ver lib/password-reset.ts.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Igual que PasswordResetToken: solo se guarda el hash del token.
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

enum LicenseOrderStatus {
  pending // creada, sin pago confirmado
  paid
  rejected
  refunded
}

// Compra de una licencia independiente (pago único). No pertenece a ninguna
// organización: la instalación se crea aparte, después del pago.
model LicenseOrder {
  id                   String             @id @default(uuid())
  name                 String
  email                String
  phone                String?
  businessName         String
  amount               Int
  currency             String
  // "profesional" (hasta 2 profesionales) o "equipo" (hasta 5).
  tier                 String             @default("profesional")
  status               LicenseOrderStatus @default(pending)
  providerPreferenceId String?
  providerPaymentId    String?            @unique
  paidAt               DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, createdAt])
  @@map("license_orders")
}

// Enlaces anteriores de un negocio que cambió su identificador de URL:
// siguen funcionando y redirigen al actual. Mientras exista el alias, ningún
// otro negocio puede usar ese identificador.
model OrganizationSlugAlias {
  slug           String   @id
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("organization_slug_aliases")
}

enum OrganizationImageKind {
  logo
  cover
  professional // foto de un profesional (Professional.photoImageId): puede haber varias por negocio
}

// Logo y portada de la página pública. Se guardan ya optimizados (WebP) en
// la base: persisten con los mismos backups que el resto de los datos y no
// dependen del disco del contenedor. Una fila por negocio y tipo; reemplazar
// una imagen crea una fila nueva (URL nueva) y borra la anterior.
model OrganizationImage {
  id             String                @id @default(uuid())
  organizationId String
  kind           OrganizationImageKind
  contentType    String
  width          Int
  height         Int
  bytes          Bytes
  createdAt      DateTime              @default(now())

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professionalPhotos Professional[]

  // Unicidad (organizationId, kind) solo para logo y portada: índice parcial
  // `organization_images_org_kind_unique`, creado en SQL (Prisma no modela índices parciales).
  @@index([organizationId, kind])
  @@map("organization_images")
}

// Acceso temporal de un cliente a sus turnos en un negocio ("Consultá tus
// turnos"). Solo se guarda el hash del token. Vale para un negocio y un
// email; pedir un enlace nuevo invalida los anteriores.
model CustomerAccessToken {
  id             String   @id @default(uuid())
  organizationId String
  email          String
  tokenHash      String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("customer_access_tokens")
}

// Invitación para que una persona acceda a Agendia dentro de un negocio.
// El token en texto plano nunca se persiste: solo su hash (como en
// EmailVerificationToken). Una invitación está atada al correo invitado, al
// negocio, al rol y (para profesionales) al perfil que va a vincular.
// La unicidad «una invitación pendiente por profesional / por correo» la
// garantizan índices parciales creados en SQL (Prisma no los modela).
model Invitation {
  id               String           @id @default(uuid())
  organizationId   String
  professionalId   String?
  email            String
  role             MembershipRole
  tokenHash        String           @unique
  status           InvitationStatus @default(pending)
  expiresAt        DateTime
  createdByUserId  String?
  acceptedByUserId String?
  acceptedAt       DateTime?
  revokedAt        DateTime?
  /// Cuántas veces se envió el correo (el alta y cada reenvío).
  sendCount        Int              @default(1)
  lastSentAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [organizationId, professionalId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email])
  @@map("invitations")
}

// ---- WhatsApp automático (Meta Cloud API oficial) -----------------------------------------------------------------
// Una conexión por negocio, con credenciales PROPIAS (cifradas) y configuración propia. Sumar un negocio es cargar
// estos datos desde /admin: no requiere código, migraciones ni variables de entorno por negocio (docs/WHATSAPP_ONBOARDING.md).
model WhatsappConnection {
  id             String    @id @default(uuid())
  organizationId String    @unique
  /// Interruptor de AtajoLab: solo con `enabled` y `status = connected` se envía algo.
  enabled        Boolean   @default(false)
  /// not_validated | connected | error  (lo fija la validación contra Meta).
  status         String    @default("not_validated")
  statusDetail   String?
  validatedAt    DateTime?
  wabaId         String?
  /// Identifica al negocio en los webhooks (llega en metadata.phone_number_id): único entre negocios.
  phoneNumberId  String?   @unique
  displayPhone   String?
  verifiedName   String?
  qualityRating  String?
  /// JSON {accessToken, appSecret} cifrado con AES-256-GCM (modules/whatsapp/crypto.ts). Nunca se muestra ni se registra.
  credentials    String?
  /// Últimos caracteres del token, solo para reconocerlo en pantalla.
  credentialsHint String?
  /// Hash (sha256) del token de verificación del webhook que se pegó en Meta; el token en claro se muestra una vez.
  verifyTokenHash String?  @unique
  templateLanguage String  @default("es_AR")
  /// Estado de cada plantilla en Meta: { kind: "APPROVED" | "PENDING" | "REJECTED" | "MISSING" }.
  templatesStatus Json?

  // Qué se envía y cuánto
  sendConfirmations   Boolean  @default(true)
  sendReminders       Boolean  @default(true)
  reminderHoursBefore Int      @default(24)
  sendCancellations   Boolean  @default(true)
  sendReschedules     Boolean  @default(true)
  /// Tope de mensajes salientes por mes calendario (UTC); al alcanzarlo no se envía más hasta el mes siguiente o hasta subirlo.
  monthlyLimit        Int      @default(300)
  /// Números (solo dígitos) a los que AtajoLab puede enviar mensajes de prueba.
  testRecipients      String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("whatsapp_connections")
}

// Consentimiento del destinatario para recibir avisos por WhatsApp de ESTE negocio. Sin un consentimiento vigente no se envía.
model WhatsappConsent {
  id             String    @id @default(uuid())
  organizationId String
  /// Número en formato internacional, solo dígitos.
  phone          String
  customerId     String?
  /// granted | revoked
  status         String    @default("granted")
  /// public_booking | dashboard | reply_stop
  source         String
  /// Versión del texto que se mostró al pedirlo (para poder demostrar qué aceptó).
  textVersion    String
  grantedAt      DateTime  @default(now())
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phone])
  @@map("whatsapp_consents")
}

// Historial de mensajes (salientes y respuestas) y sus estados de entrega. Base del consumo por negocio.
model WhatsappMessage {
  id                String   @id @default(uuid())
  organizationId    String
  appointmentId     String?
  /// La notificación del outbox que lo originó: un envío por notificación, nunca dos.
  notificationId    String?  @unique
  /// outbound | inbound
  direction         String
  /// booking_confirmation | reminder | cancellation | reschedule | test | reply
  kind              String
  /// Número del destinatario (salientes) o del remitente (entrantes), solo dígitos.
  phone             String?
  /// Identificador de usuario de WhatsApp (BSUID) cuando Meta no informa el número.
  bsuid             String?
  templateName      String?
  /// queued | sending | sent | delivered | read | failed | unknown | received
  status            String
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  isTest            Boolean  @default(false)
  /// Texto de una respuesta entrante (recortado); nunca contenido de salientes.
  body              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, providerMessageId])
  @@index([organizationId, createdAt])
  @@index([organizationId, direction, createdAt])
  @@map("whatsapp_messages")
}
